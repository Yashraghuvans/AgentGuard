{
  "name": "agentguard-sf",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, open-source Apex firewall between AI agents and your Salesforce data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashraghuvanshi/agentguard-sf"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "pmd:apex": "bash scripts/ci/run-pmd.sh",
    "test": "sf apex run test --code-coverage --result-format json --output-dir ./test-results --wait 30",
    "coverage": "node scripts/ci/check-coverage.js ./test-results 90"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-apex": "^2.1.0"
  },
  "lint-staged": {
    "*.{cls,trigger}": "prettier --write",
    "*.{js,mjs,cjs,json,md,yml,yaml,html,css}": "prettier --write"
  }
}
